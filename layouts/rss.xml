{{- $pctx := . -}}
{{- if .IsHome -}}{{ $pctx = .Site -}}{{- end -}}
{{- $pages := slice -}}
{{- if or $.IsHome $.IsSection -}}
{{- $pages = $pctx.RegularPages -}}
{{- else -}}
{{- $pages = $pctx.Pages -}}
{{- end -}}
{{- $limit := .Site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}
{{- $pages = $pages | first $limit -}}
{{- end -}}
{{- $baseURL := .Site.BaseURL | strings.TrimSuffix "/" -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if eq .Title .Site.Title }}{{ .Site.Title }}{{ else if in .Title .Site.Title }}{{ .Title }}{{ else }}{{ .Title }} van {{ .Site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ with .Description }}{{ . | plainify }}{{ else with .Site.Params.description }}{{ . }}{{ else }}{{ $.Site.Title }}{{ end }}</description>
    {{- with site.Language.Lang }}<language>{{ . }}</language>{{ end }}
    {{- if gt (len $pages) 0 }}{{ $first := index $pages 0 }}{{ $buildDate := cond $first.Date.IsZero $first.Lastmod $first.Date }}<lastBuildDate>{{ $buildDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    {{- with .OutputFormats.Get "rss" }}{{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType.Type | safeHTML }}{{ end }}
    {{- range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      {{- $pubDate := cond .Date.IsZero .Lastmod .Date }}
      <pubDate>{{ $pubDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <atom:updated>{{ .Lastmod.Format "2006-01-02T15:04:05Z07:00" | safeHTML }}</atom:updated>
      <guid>{{ .Permalink }}</guid>
      <description>{{ .Content | replaceRE `(<(?:a|img)[^>]+(?:href|src)=")(/[^"]*)` (printf "${1}%s${2}" $baseURL) | transform.XMLEscape | safeHTML }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
