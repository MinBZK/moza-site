{{- /* Manifest van pagina's die downloads aanbieden (front matter: download: true).
       scripts/render-downloads.js leest dit en genereert per pagina .odt en .pdf;
       een presentatie (layout nldd-deck) krijgt standaard alleen de .pdf, tenzij
       download: false. */ -}}
{{- $list := slice -}}
{{- range site.RegularPages -}}
  {{- $deck := eq .Layout "nldd-deck" -}}
  {{- if or (eq .Params.download true) (and $deck (ne .Params.download false)) -}}
    {{- $entry := dict
      "relPermalink" .RelPermalink
      "name" (path.Base .RelPermalink)
      "title" .Title
    -}}
    {{- if $deck -}}
      {{- $entry = merge $entry (dict "deck" true "description" .Description "url" .Permalink) -}}
    {{- end -}}
    {{- $list = $list | append $entry -}}
  {{- end -}}
{{- end -}}
{{- $list | jsonify -}}
